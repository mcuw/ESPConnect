{
  "name": "espconnect",
  "productName": "ESPConnect",
  "private": true,
  "version": "1.1.24",
  "type": "module",
  "description": "Browser-based control center for ESP32 and ESP8266 boards",
  "author": "mcuw",
  "license": "MIT",
  "engines": {
    "pnpm": ">=10.26.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fatfs": "vitest run src/tests/fatfs.fixture.test.ts",
    "test:e2e": "playwright test",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "tasmota-webserial-esptool": "7.3.10",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vuetify": "^4.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "patch-package": "^8.0.1",
    "sass": "^1.100.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.2"
  },
  "packageManager": "pnpm@11.5.0"
}
